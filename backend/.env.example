# VoteVibes Environment Configuration
# Generate 64-byte random hex secrets using: openssl rand -hex 64 or npm run generate-secrets

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
# In production, ensure SSL connection mode is appended: ?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/votevibes?schema=public

# Client URLs & CORS Settings (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Authentication Secrets (MUST be strong random hex strings in production!)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_votevibes_2026_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_votevibes_2026_change_in_production

# Token Expirations
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
